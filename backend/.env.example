# --- required ---------------------------------------------------------------
# change me: the connection string from step 4 (Atlas or local).
MONGODB_URI=mongodb+srv://solver:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# For a local MongoDB use instead:
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=solver-agent

# change me: at least one provider key from step 5. The default configuration
# uses OpenAI for every agent, so OPENAI_API_KEY is required unless you edit
# backend/src/agents/llmClient.ts.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# HUGGINGFACE_API_KEY=hf_...

# --- sandbox ----------------------------------------------------------------
# change me: the absolute path printed at the end of step 7.
PYTHON_BIN=/Users/you/solver-agent/backend/python/.venv/bin/python

# Optional sandbox limits (defaults shown; see README "Configuration reference").
# PYTHON_TIMEOUT_MS=60000            # wall-clock cap per script run
# PYTHON_HEAVY_TIMEOUT_MS=240000     # cap for the numerical / CY analyst agents
# PYTHON_MAX_TIMEOUTS=3              # timeouts a sub-agent may hit before giving up
# PYTHON_MAX_MEMORY_BYTES=2147483648 # RLIMIT_AS / RLIMIT_DATA (2 GiB); not enforced on macOS
# PYTHON_MAX_CPU_SECONDS=            # CPU rlimit; derived from the timeout when unset, 0 disables
# PYTHON_MAX_OUTPUT_BYTES=8388608    # captured stdout+stderr cap (8 MiB)
# PYTHON_MAX_ARTIFACT_BYTES=2097152  # per-file cap for captured artifacts (2 MiB)

# --- agents -----------------------------------------------------------------
# Optional turn budgets (defaults shown).
# AGENT_MAX_TURNS=40                 # Main solver turns per run
# SUB_AGENT_MAX_TURNS=12             # turns per computation / verification sub-agent

# Optional JSON overriding or extending the model pricing table in
# src/config/pricing.ts (USD per 1M tokens), e.g.
# MODEL_PRICING_JSON={"gpt-5.6-sol":{"input":4,"cachedInput":0.4,"output":20}}

# --- server -----------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200
# NODE_ENV=development               # development | production | test