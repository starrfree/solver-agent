{
  "name": "solver-agent-backend",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Solver Agent backend - Express + MongoDB + OpenAI Responses API orchestrator",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/agents/__tests__/clientAudit.test.ts src/agents/__tests__/computationGuard.test.ts src/agents/__tests__/subAgentLoop.test.ts src/export/__tests__/export.test.ts",
    "test:audit": "tsx --test src/agents/__tests__/clientAudit.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/genai": "^2.23.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "katex": "^0.18.7",
    "marked": "^18.0.12",
    "mongodb": "^7.2.0",
    "openai": "^6.37.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prismjs": "^1.30.0",
    "python-shell": "^5.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.6.2",
    "@types/prismjs": "^1.26.6",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
